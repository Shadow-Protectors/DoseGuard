# Ignore test directories
**/test/
**/tests/

test/
tests/

# Ignore all Markdown files except the main project README
*.md
!README.md

# Ignore dependency folders
node_modules/
**/node_modules/
__pycache__/
**/__pycache__/
.venv/
venv/
.env
.env.*

# Ignore OS/editor files
.DS_Store
Thumbs.db
