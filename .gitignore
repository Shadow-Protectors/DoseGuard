# DoseGuard - Comprehensive .gitignore

# Android & Gradle Build Artifacts
build/
**/build/
.gradle/
**/.gradle/
.kotlin/
**/.kotlin/
local.properties
*.apk
*.aab
*.apks
*.dex
*.class
*.jks
*.keystore
captures/
.externalNativeBuild/
.cxx/

# Node.js Dependencies & Cache
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python & Testing Caches
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
**/.pytest_cache/
.coverage
htmlcov/
.venv/
venv/
ENV/

# Local Databases & Logs
*.db
*.sqlite
*.sqlite3
*.log

# Environment & Secrets (Keep .env.example tracked)
.env
.env.*
!.env.example

# IDE & Editor Directories
.idea/
**/.idea/
.vscode/
**/.vscode/
*.swp
*.swo
*~

# Agent & AI tool workspace caches
.agent/
.agents/

# Operating System Files
.DS_Store
Thumbs.db
ehthumbs.db
