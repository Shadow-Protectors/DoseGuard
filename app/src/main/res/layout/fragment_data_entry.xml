<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Manual Dosimeter Record Entry"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Enter shift inspection metrics for kinetic dose computation"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:layout_marginBottom="16dp" />

        <!-- Form Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/card_dark"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Worker ID Input -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Worker ID"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/et_worker_id"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#20FFFFFF"
                    android:padding="12dp"
                    android:text="W-4029"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:layout_marginBottom="12dp" />

                <!-- Worker Name Input -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Worker Name"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/et_worker_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#20FFFFFF"
                    android:padding="12dp"
                    android:text="Hari"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:layout_marginBottom="12dp" />

                <!-- Badge ID Input -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dosimeter Badge Serial Number"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/et_badge_id"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#20FFFFFF"
                    android:padding="12dp"
                    android:text="BDG-9901"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:layout_marginBottom="12dp" />

                <!-- Department Input -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Plant Department"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/et_department"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#20FFFFFF"
                    android:padding="12dp"
                    android:text="Refining"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:layout_marginBottom="12dp" />

                <!-- Shift Hours & Delta-E Inputs in Horizontal layout -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginEnd="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Shift Duration (hrs)"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                        <EditText
                            android:id="@+id/et_shift_hours"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="#20FFFFFF"
                            android:inputType="numberDecimal"
                            android:padding="12dp"
                            android:text="8.0"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Measured Delta-E (ΔE)"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                        <EditText
                            android:id="@+id/et_delta_e"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="#20FFFFFF"
                            android:inputType="numberDecimal"
                            android:padding="12dp"
                            android:text="14.5"
                            android:textColor="@color/accent_cyan"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Submit Button -->
        <Button
            android:id="@+id/btn_submit_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/accent_cyan"
            android:text="Calculate Exposure &amp; Save Record"
            android:textColor="@color/bg_dark"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- Output Calculation Summary Banner -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_entry_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/card_dark"
            app:cardCornerRadius="12dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tv_result_header"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Exposure Calculation Result"
                    android:textColor="@color/accent_cyan"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_result_detail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Estimated TWA: 0.81 ppm | Risk: SAFE"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
