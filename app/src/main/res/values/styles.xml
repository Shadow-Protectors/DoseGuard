<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme used by the Compose activity -->
    <style name="Theme.DoseGuard" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">#0D47A1</item>
        <item name="android:navigationBarColor">#0D47A1</item>
        <item name="android:windowBackground">#F4F7FA</item>
    </style>

    <!-- Splash theme applied before Compose is ready -->
    <style name="LaunchTheme" parent="@android:style/Theme.Material.Light.NoActionBar.Fullscreen">
        <item name="android:windowBackground">#0D47A1</item>
        <item name="android:statusBarColor">#0D47A1</item>
    </style>
</resources>
